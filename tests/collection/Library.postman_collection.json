		{
			"name": "Change password",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse JSON response safely",
							"let res;",
							"try {",
							"  res = pm.response.json();",
							"} catch (e) {",
							"  res = {};",
							"  console.warn(\"No JSON response or invalid JSON\");",
							"}",
							"",
							"// Parse request body to extract the new password",
							"let body;",
							"try {",
							"  body = JSON.parse(pm.request.body.raw);",
							"} catch (e) {",
							"  body = {};",
							"}",
							"",
							"const newPassword = body.password;",
							"",
							"// Update the environment variable only if successful",
							"if (pm.response.code === 200 && newPassword) {",
							"  pm.environment.set(\"password\", newPassword);",
							"  console.log(\"Password updated in environment:\", newPassword);",
							"} else {",
							"  console.warn(\"Password not updated. Response code:\", pm.response.code);",
							"}",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"password\": \"test\"\n}",
