		{
			"name": "Change password",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse JSON response safely",
							"let res;",
							"try {",
							"  res = pm.response.json();",
							"} catch (e) {",
							"  res = {};",
							"  console.warn(\"No JSON response or invalid JSON\");",
							"}",
							"",
							"// Parse request body to extract the new password",
							"let body;",
							"try {",
							"  body = JSON.parse(pm.request.body.raw);",
							"} catch (e) {",
							"  body = {};",
							"}",
							"",
							"const newPassword = body.password;",
							"",
							"// Update the environment variable only if successful",
							"if (pm.response.code === 200 && newPassword) {",
							"  pm.environment.set(\"password\", newPassword);",
							"  console.log(\"Password updated in environment:\", newPassword);",
							"} else {",
							"  console.warn(\"Password not updated. Response code:\", pm.response.code);",
							"}",
							"",
							"// ================================",
							"// TEST CASES",
							"// ================================",
							"pm.test(\"Response code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response body is JSON\", function () {",
							"    pm.expect(() => pm.response.json()).to.not.throw();",
							"});",
							"",
							"pm.test(\"Request body contains password\", function () {",
							"    pm.expect(body).to.have.property(\"password\");",
							"    pm.expect(newPassword).to.be.a(\"string\").and.to.not.be.empty;",
							"});",
							"",
							"pm.test(\"Password updated in environment if response is OK\", function () {",
							"    if (pm.response.code === 200 && newPassword) {",
							"        pm.expect(pm.environment.get(\"password\")).to.eql(newPassword);",
							"    } else {",
							"        pm.expect(pm.environment.get(\"password\")).to.not.eql(newPassword);",
							"    }",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [],
				"body": {
					"mode": "raw",
