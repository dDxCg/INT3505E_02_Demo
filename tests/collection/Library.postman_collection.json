	"item": [
		{
			"name": "Register",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Generate unique creds",
							"const uniqueEmail = `user_${Date.now()}@test.com`;",
							"const password = \"test123\";",
							"",
							"// Save to *environment* (persistent during run)",
							"pm.environment.set(\"email\", uniqueEmail);",
							"pm.environment.set(\"password\", password);",
							"",
							"console.log(\"Generated creds:\", { email: uniqueEmail, password });",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 201\", function () {",
							"  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"const json = pm.response.json();",
							"",
							"pm.test(\"User created successfully\", function () {",
							"  pm.expect(json.msg).to.eql(\"User created\");",
							"});",
							"",
							"console.log(\"✅ Registered new user:\", pm.environment.get(\"email\"));",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://127.0.0.1:5000/api/v6/auth/register",
					"protocol": "http",
					"host": [
						"127",
						"0",
						"0",
						"1"
					],
					"port": "5000",
					"path": [
						"api",
						"v6",
						"auth",
						"register"
					]
				}
			},
			"response": []
