    "/v4/books/": {
      "get": {
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Book"
            },
            "headers": {
              "ETag": {
                "description": "Current ETag of the resource",
                "type": "string"
              },
              "Cache-Control": {
                "description": "Cache max-age in seconds",
                "type": "string"
              },
              "X-Cache": {
                "description": "HIT or MISS",
                "type": "string"
              },
              "X-Cache-Timeout": {
                "description": "Cache TTL in seconds",
                "type": "string"
              }
            }
          },
          "304": {
