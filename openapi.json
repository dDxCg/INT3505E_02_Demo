  "info": {
    "title": "Library API",
    "version": "1.0"
  },
  "produces": [
    "application/json"
  ],
  "consumes": [
    "application/json"
  ],
  "securityDefinitions": {
    "Bearer Auth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "Add 'Bearer <JWT>' here"
    }
  },
  "tags": [
