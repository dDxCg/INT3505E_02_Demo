      "name": "v2/books",
      "description": "Books operations"
    },
    {
      "name": "v2/copies",
      "description": "Copies operations"
    },
    {
      "name": "v2/borrows",
      "description": "Borrow operations"
    },
    {
      "name": "v3/auth",
      "description": "Authentication operations"
    },
    {
      "name": "v3/books",
      "description": "Books operations"
    },
    {
      "name": "v3/borrows",
      "description": "Borrow operations"
    },
    {
      "name": "v3/admin/books",
      "description": "Admin books routes"
    },
    {
      "name": "v3/admin/borrows",
      "description": "Admin borrows routes"
    },
    {
      "name": "v3/admin/copies",
      "description": "Admin copies routes"
    },
    {
      "name": "v4/books",
      "description": "Books operations"
    }
  ],
  "definitions": {
    "Book": {
      "required": [
        "author",
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Book title"
        },
        "author": {
          "type": "string",
          "description": "Book author"
        },
        "year": {
          "type": "integer",
          "description": "Publication year"
        }
      },
      "type": "object"
    },
    "Copy": {
      "properties": {
        "status": {
          "type": "string",
          "description": "Copy status",
          "default": "Available"
        }
      },
      "type": "object"
    },
    "Borrow": {
      "properties": {
        "user_id": {
          "type": "integer",
          "description": "User ID"
        },
        "copy_id": {
          "type": "integer",
          "description": "Copy ID"
        },
        "return_date": {
          "type": "string",
          "description": "Return date in ISO format"
        }
      },
      "type": "object"
    },
    "UserRegister": {
      "required": [
        "email",
        "password"
      ],
      "properties": {
        "email": {
          "type": "string",
          "description": "Unique email"
        },
        "password": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Token": {
      "properties": {
        "access_token": {
          "type": "string",
          "description": "JWT access token"
        }
      },
      "type": "object"
    },
    "ChangePassword": {
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "type": "string",
          "description": "New password"
        }
      },
      "type": "object"
    }
  },
  "responses": {
    "ParseError": {
      "description": "When a mask can't be parsed"
    },
    "MaskError": {
      "description": "When any error occurs on mask"
    }
  }
}